# Copy these keys into Streamlit Community Cloud:
# App > Settings > Secrets
# Never commit your real client_secret to GitHub.

[microsoft]
client_id = "YOUR_APPLICATION_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET_VALUE"
authority = "https://login.microsoftonline.com/consumers"
redirect_uri = "https://YOUR-STREAMLIT-APP.streamlit.app/"
onedrive_file_path = "/AED System/IB_list_TEST.xlsx"

# Optional local-only fallback. It is ignored when the complete [microsoft]
# section above is configured.
# [excel]
# file_path = "C:\\Users\\YourName\\OneDrive\\AED System\\IB_list_TEST.xlsx"
