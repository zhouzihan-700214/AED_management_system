# Copy this content into Streamlit Cloud -> App settings -> Secrets.
# Replace the placeholders. Never commit real credentials to GitHub.

[onemap]
email = "REPLACE_WITH_ONEMAP_EMAIL"
password = "REPLACE_WITH_ONEMAP_PASSWORD"

[microsoft]
client_id = "REPLACE_WITH_APPLICATION_CLIENT_ID"
client_secret = "REPLACE_WITH_CLIENT_SECRET_VALUE"
authority = "https://login.microsoftonline.com/consumers"
redirect_uri = "https://REPLACE_WITH_YOUR_APP_NAME.streamlit.app/"
onedrive_file_path = "/AED System/IB_list_TEST.xlsx"
# Optional. The default keeps system-only records separate from the IB List.
system_state_path = "/AED System/AED_System_State.zip"
