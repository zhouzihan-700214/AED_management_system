# Optional: point the system to the Excel file inside your own OneDrive folder.
# Copy this file to .streamlit/secrets.toml and replace the path below.
# The system also auto-detects common OneDrive/AED System locations.

[excel]
file_path = "C:\\Users\\YOUR_NAME\\OneDrive\\AED System\\IB_list_TEST.xlsx"

# Existing OneMap settings can remain below when needed.
# ONEMAP_EMAIL = ""
# ONEMAP_PASSWORD = ""
